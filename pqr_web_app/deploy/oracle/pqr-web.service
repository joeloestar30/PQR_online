[Unit]
Description=PQR Online Flask web service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pqr
Group=pqr
WorkingDirectory=/opt/pqr/PQR_online/pqr_web_app
EnvironmentFile=/etc/pqr/pqr.env
ExecStart=/opt/pqr/PQR_online/pqr_web_app/.venv/bin/gunicorn --workers 2 --bind 127.0.0.1:8000 app:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

