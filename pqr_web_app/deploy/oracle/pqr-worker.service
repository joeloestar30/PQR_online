[Unit]
Description=PQR Online background worker
After=network-online.target pqr-web.service
Wants=network-online.target

[Service]
Type=simple
User=pqr
Group=pqr
WorkingDirectory=/opt/pqr/PQR_online/pqr_web_app
EnvironmentFile=/etc/pqr/pqr.env
ExecStart=/opt/pqr/PQR_online/pqr_web_app/.venv/bin/python run_worker.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

